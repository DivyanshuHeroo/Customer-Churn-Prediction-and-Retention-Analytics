models/*.joblib
models/*.pkl
models/*.json

# Generated figures & reports
reports/figures/*.png
reports/*.json
reports/*.csv

# OS / IDE
.DS_Store
.vscode/
.idea/

# Keep folder placeholders
!**/.gitkeep
